          "strategy": "checklist",
          "rules": [
            {
              "ruleName": "expressMissingFundingAccount",
              "errorMessage": "A funding account is required for Express.",
              "condition": {
                "field": "company.fundingAccount",
                "operator": "is_null_or_empty"
              }
            }
          ]
        }
      ],
