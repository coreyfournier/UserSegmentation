    {
      "key": "tAGates",
      "name": "T\u0026A Gates",
      "revision": 25,
      "updatedAt": "2026-09-07T23:42:44.978698046Z",
      "segments": [
        {
          "id": "Stage1",
          "name": "Stage 1 Gates",
          "when": {
            "ruleName": "ProductCheck",
            "enabled": true,
            "condition": {
              "field": "ProductType",
              "operator": "eq",
              "value": "T\u0026A"
            }
          },
          "strategy": "checklist",
          "static": {
            "mappings": {},
            "default": ""
          },
          "computed": [
            {
              "name": "MinimumConsecutivePayCycles",
              "type": "number",
              "formula": "2"
            },
            {
              "name": "HasMinimumConsecutivePayCycles",
              "type": "boolean",
              "formula": "ConsecutivePaycyclesEmployeed \u003e MinimumConsecutivePayCycles"
            }
          ],
          "rules": [
            {
              "ruleName": "WorkHistory2Cycles",
              "condition": {
                "field": "ConsecutivePaycyclesEmployeed",
                "operator": "lt",
                "valueField": "MinimumConsecutivePayCycles"
              },
              "messages": {
                "en": "You must have at least ${MinimumConsecutivePayCycles} consecutive pay cycles worked."
              },
              "outputs": {
                "RiskReason": "no_income_signal"
              }
            },
            {
              "ruleName": "No NSF or derogatory",
              "condition": {
                "field": "AccountHasNsfDerogatory",
                "operator": "eq",
                "value": true
              },
              "outputs": {
                "RiskReason": "banking_history_disqualifying"
              }
            }
          ]
        },
        {
          "id": "Stage2Gates",
          "name": "Stage 2 Gates",
          "when": {
            "ruleName": "",
            "condition": {
              "field": "ProductType",
              "operator": "eq",
              "value": "T\u0026A"
            }
          },
          "strategy": "checklist",
          "rules": [
            {
              "ruleName": "Recurring direct deposit",
              "condition": {
                "field": "AccountHasRecurringDirectDeposit",
                "operator": "eq",
                "value": false
              },
              "messages": {
                "en": "Your bank account doesn't have any direct deposits on a frequent basis."
              },
              "outputs": {
                "RiskReason": "no_income_signal"
              }
            }
          ]
        }
      ],
      "defaultLanguage": "en",
      "inputSchema": {
        "AccountHasNsfDerogatory": {
          "type": "boolean",
          "required": true
        },
        "AccountHasPriorReturns": {
          "type": "boolean",
          "required": false
        },
        "AccountHasRecurringDirectDeposit": {
          "type": "boolean",
          "required": true
        },
        "AccountIsLinked": {
          "type": "boolean",
          "required": false
        },
        "ConsecutivePaycyclesEmployeed": {
          "type": "number",
          "required": true
        },
        "HasDepositAccount": {
          "type": "boolean",
          "required": false
        },
        "IsDelinquent": {
          "type": "boolean",
          "required": true
        },
        "PriorChargeOffs": {
          "type": "number",
          "required": true
        },
        "ProductType": {
          "type": "string",
          "required": true,
          "lookup": "producttype"
        }
      },
      "outputSchema": {
        "RiskReason": {
          "type": "string",
          "lookup": "riskreasoncodes"
        }
      }
    },
    {
      "key": "balanceDiagnosis",
      "name": "Balance Diagnosis",
      "revision": 2,
      "updatedAt": "2026-09-08T13:57:21.245471617Z",
      "segments": [
        {
          "id": "CompanyHealthDiagnoser",
          "name": "Company Health Diagnoser",
          "strategy": "checklist",
          "rules": [
            {
              "ruleName": "CheckEmployeeSyncFailed",
              "condition": {
                "field": "EmployeeStatus",
                "operator": "eq",
                "value": "Failed"
              },
              "messages": {
                "en": "We're seeing a sync issue between your employer's payroll system and Tapcheck that's affecting all employees. Our integrations team is looking into it."
              },
              "outputs": {
                "Category": "DataSync",
                "Description": "Company Health reports employee sync status as Failed. The result code is '${ResultCode}'.",
                "Severity": "Critical",
                "Signals": "[{Name: \"EmployeeStatus\", Value: EmployeeStatus}, {Name: \"EmployeeCount\", Value: EmployeeCount}, {Name: \"EmployeeReason\", Value: EmployeeReason}]",
                "TechnicalExplanation": "Company Health Service sets EmployeeStatus via PayrollEmployeesLoadedEvent — Failed means the payroll-to-Tapcheck employee sync pipeline failed. This affects ALL employees at the company because no employee records can be updated."
              }
            },
            {
              "ruleName": "CheckPaycheckSyncFailed",
              "operator": "And",
              "rules": [
                {
                  "ruleName": "",
                  "condition": {
                    "field": "UsesPaychecks",
                    "operator": "eq",
                    "value": true
                  }
                },
                {
                  "ruleName": "",
                  "condition": {
                    "field": "PaycheckSyncStatus",
                    "operator": "eq",
                    "value": "Failed"
                  }
                }
              ],
              "messages": {
                "en": "There's an issue importing paycheck history from your employer's payroll system. Our team is working to fix the connection."
              },
              "outputs": {
                "Category": "DataSync",
                "Description": "Company Health reports paycheck sync status as Failed.",
                "DiagnosisType": "PaycheckSyncFailed",
                "Severity": "Critical",
                "Signals": "[{Name: \"PaycheckSyncStatus\", Value: PaycheckSyncStatus}, \n{Name: \"PaycheckSyncReason\", Value: PaycheckSyncReason},\n{Name: \"PaycheckCount\", Value: PaycheckCount}]",
                "TechnicalExplanation": "Company Health Service sets PaycheckSyncStatus via PaychecksImportedEvent — Failed means historical paycheck data can't import from payroll. Only checked when UsesPaychecks = true. Affects calc methods that depend on paycheck history."
              }
            }
          ],
          "default": "Good"
        }
      ],
      "defaultLanguage": "en",
