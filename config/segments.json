    {
      "key": "ctFeeOverride",
      "name": "ct-fee-override",
      "segments": [
        {
          "id": "ct-fee",
          "strategy": "rule",
          "computed": [
            {
              "name": "CTTotal",
              "type": "number",
              "formula": "sum(map(filter(Employees, {.State == \"CT\"}), {.TransferSpendThisMonth}))"
            },
            {
              "name": "TransferFee",
              "type": "number",
              "formula": "CTTotal \u003e 30.0 ? 0.0 : (CTTotal + 4.0 \u003e 30.0 ? 30.0 - CTTotal : 4.0)"
            }
          ],
          "rules": [
            {
              "ruleName": "fee-waived",
              "successEvent": "fee-waived",
              "condition": {
                "field": "CTTotal",
                "operator": "gt",
                "value": 30
              }
            },
            {
              "ruleName": "fee-partial",
              "successEvent": "fee-partial",
              "condition": {
                "field": "CTTotal",
                "operator": "gt",
                "value": 26
              }
            }
          ],
          "default": "fee-standard"
        }
      ],
      "inputSchema": {
        "Employees": {
          "type": "array",
          "required": true
        }
      }
