    {
      "name": "company-payroll-setup",
      "dependsOn": [
        "company-identity"
      ],
      "segments": [
        {
          "id": "precision",
          "when": {
            "ruleName": "isPrecision",
            "expression": {
              "field": "company.productType",
              "operator": "eq",
              "value": "Precision"
            }
          },
          "strategy": "checklist",
          "expressions": [
            {
              "name": "PayPeriodDatesValid",
              "type": "boolean",
              "expression": "company.periodEnd != '' \u0026\u0026 company.checkDate \u003e company.periodEnd"
            }
          ],
          "rules": [
            {
              "ruleName": "payFrequencyUnsupportedForPrecision",
              "errorMessage": "Pay frequency ${company.payFrequency} is not supported for Precision. Use biweekly or semimonthly.",
              "expression": {
                "field": "company.payFrequency",
                "operator": "not_in",
                "value": [
                  "biweekly",
                  "semimonthly"
                ]
              }
            },
            {
              "ruleName": "payPeriodDatesOutOfSequence",
              "errorMessage": "Pay period end must be set, and the check date must fall after it.",
              "expression": {
                "field": "PayPeriodDatesValid",
                "operator": "eq",
                "value": false
              }
            },
            {
              "ruleName": "precisionMissingDefaultPayRate",
              "operator": "Or",
              "errorMessage": "A default pay rate is required for Precision companies.",
              "rules": [
                {
                  "ruleName": "defaultPayRateAbsent",
                  "expression": {
                    "field": "company.defaultPayRate",
                    "operator": "is_null"
                  }
                },
                {
                  "ruleName": "defaultPayRateNotPositive",
                  "expression": {
                    "field": "company.defaultPayRate",
                    "operator": "lte",
                    "value": 0
                  }
                }
              ]
            }
          ],
          "inputSchema": {
            "company.anchorDate": {
              "type": "string",
              "required": true
            },
            "company.checkDate": {
              "type": "string",
              "required": true
            },
            "company.defaultPayRate": {
              "type": "number",
              "required": false
            },
            "company.payFrequency": {
              "type": "string",
              "required": true
            },
            "company.periodEnd": {
              "type": "string",
              "required": true
            },
            "company.productType": {
              "type": "string",
              "required": true
            }
          }
        },
        {
          "id": "express",
          "when": {
            "ruleName": "isExpress",
            "expression": {
              "field": "company.productType",
              "operator": "eq",
              "value": "Express"
            }
          },
          "strategy": "checklist",
          "rules": [
            {
              "ruleName": "expressMissingFundingAccount",
              "errorMessage": "A funding account is required for Express.",
              "expression": {
                "field": "company.fundingAccount",
                "operator": "is_null_or_empty"
              }
            }
          ],
          "inputSchema": {
            "company.fundingAccount": {
              "type": "string",
              "required": true
            },
            "company.productType": {
              "type": "string",
              "required": true
            }
          }
        }
      ]
    },
