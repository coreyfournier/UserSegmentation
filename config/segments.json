    {
      "key": "ctFeeOverride",
      "name": "CT Compliance (Max Fee)",
      "revision": 0,
      "segments": [
        {
          "id": "ct-fee",
          "strategy": "rule",
          "computed": [
            {
              "name": "MaxTransferFee",
              "type": "number",
              "formula": "30"
            },
            {
              "name": "CTTotal",
              "type": "number",
              "formula": "sum(map(filter(Employees, {.State == \"CT\"}), {.TransferSpendThisMonth}))"
            },
            {
              "name": "TransferFee",
              "type": "number",
              "formula": "CTTotal \u003e MaxTransferFee ? 0.0 : (CTTotal + TransferFee \u003e MaxTransferFee ? MaxTransferFee - CTTotal : TransferFee )"
            },
            {
              "name": "HasMaxFeeBeenReached",
              "type": "boolean",
              "formula": "CTTotal \u003e= MaxTransferFee"
            }
          ],
          "rules": [
            {
              "ruleName": "fee-waived",
              "successEvent": "fee-waived",
              "condition": {
                "field": "HasMaxFeeBeenReached",
                "operator": "eq",
                "value": "True"
              },
              "outputs": {
                "TransferFee": "TransferFee"
              }
            },
            {
              "ruleName": "fee-partial",
              "successEvent": "fee-partial",
              "condition": {
                "field": "CTTotal",
                "operator": "gte",
                "value": 26
              },
              "outputs": {
                "TransferFee": "TransferFee"
              }
            }
          ],
          "default": "fee-standard"
        }
      ],
      "defaultLanguage": "en",
      "inputSchema": {
        "Employees": {
          "type": "array",
          "required": true
        },
        "TransferFee": {
          "type": "number",
          "required": true
        }
      },
      "outputSchema": {
        "TransferFee": {
          "type": "number"
        }
      }
    },
    {
      "key": "ewaEligibility",
      "name": "ewa-eligibility",
      "revision": 0,
      "segments": [
        {
          "id": "ewa-eligibility",
          "strategy": "rule",
          "computed": [
            {
              "name": "MaxAllowed",
              "type": "number",
              "formula": "min(EarnedWages * 0.5, StateCap)"
            },
            {
              "name": "Eligible",
              "type": "boolean",
              "formula": "DaysWorked \u003e= 14 \u0026\u0026 RequestedAmount \u003c= MaxAllowed"
            }
          ],
          "rules": [
            {
              "ruleName": "ineligible-tenure",
              "successEvent": "ineligible-tenure",
              "condition": {
                "field": "DaysWorked",
                "operator": "lt",
                "value": 14
              }
            },
            {
              "ruleName": "ineligible-amount",
              "successEvent": "ineligible-amount",
              "condition": {
                "field": "Eligible",
                "operator": "eq",
                "value": false
              }
            }
          ],
          "default": "eligible"
        }
      ],
      "inputSchema": {
        "DaysWorked": {
          "type": "number",
          "required": true
        },
        "EarnedWages": {
          "type": "number",
          "required": true
        },
        "RequestedAmount": {
          "type": "number",
          "required": true
        },
        "StateCap": {
          "type": "number",
          "required": true
        }
      }
    },
    {
      "key": "ewaRisk",
      "name": "ewa-risk",
      "revision": 4,
      "updatedAt": "2026-09-09T13:26:14.805872241Z",
      "segments": [
        {
          "id": "ewa-risk",
          "strategy": "rule",
          "computed": [
            {
              "name": "Z",
              "type": "number",
              "formula": "w0 + sum(map(Signals, {.weight * .score * exp(-.age_sec / .tau_sec)}))"
            },
            {
              "name": "P",
              "type": "number",
              "formula": "1.0 / (1.0 + exp(-Z))"
            },
            {
              "name": "M",
              "type": "number",
              "formula": "Fee - AchCost"
            },
            {
              "name": "RiskCeiling",
              "type": "number",
              "formula": "(M * (1.0 - P) - AchCost * P) / (P + Lambda * P * (1.0 - P))"
            },
            {
              "name": "NetPayCap",
              "type": "number",
              "formula": "Alpha * NetPay"
            },
            {
              "name": "Offered",
              "type": "number",
              "formula": "max(0.0, min(RiskCeiling, NetPayCap))"
            },
            {
              "name": "BindingLimit",
              "type": "string",
              "formula": "RiskCeiling \u003c NetPayCap ? \"risk-ceiling\" : \"net-pay-cap\""
            }
          ],
          "rules": [
            {
              "ruleName": "below-minimum",
              "successEvent": "decline",
              "condition": {
                "field": "Offered",
                "operator": "lt",
                "value": 1
              },
              "outputs": {
                "NetPay": "0"
              }
            },
            {
              "ruleName": "risk-limited",
              "successEvent": "approve-risk-ceiling",
              "condition": {
                "field": "RiskCeiling",
                "operator": "lt",
                "valueField": "NetPayCap"
              },
              "outputs": {
                "NetPay": "Offered"
              }
            }
          ],
          "default": "approve-net-pay-cap",
          "defaultOutputs": {
            "NetPay": "Offered"
          }
        }
      ],
      "defaultLanguage": "en",
      "inputSchema": {
        "AchCost": {
          "type": "number",
          "required": true
        },
        "Alpha": {
          "type": "number",
          "required": true
        },
        "Fee": {
          "type": "number",
          "required": true
        },
        "Lambda": {
          "type": "number",
          "required": true
        },
        "NetPay": {
          "type": "number",
          "required": true
        },
        "Signals": {
          "type": "array",
          "required": true
        },
        "w0": {
          "type": "number",
          "required": true
        }
      },
      "outputSchema": {
        "NetPay": {
          "type": "number"
        }
      }
    },
